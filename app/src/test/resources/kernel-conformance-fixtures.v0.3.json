{
  "version": 3,
  "status": "DRAFT",
  "purpose": "Small cross-runtime semantic fixtures for Run, Observation, Verification, Evidence, authority, continuation, and cache boundaries. These fixtures do not prove runtime conformance until executed by at least two materially different implementations. Version 0.3 replaces invalid placeholder effect digests in v0.2 with parameter maps and canonical SHA-256 digests, and makes attempt identity explicit in reservation vectors.",
  "cases": [
    {
      "id": "K-IDENTITY-01",
      "name": "run identity is stable",
      "input": {
        "run_id": "run_conformance_001",
        "goal": "validate a deterministic capability path"
      },
      "assertions": [
        "run_id remains identical across continuation and observation records",
        "the same run_id is not silently reused for a different goal"
      ]
    },
    {
      "id": "K-EVIDENCE-01",
      "name": "observation is not evidence",
      "input": {
        "observation_id": "obs_001",
        "evidence_id": "ev_001"
      },
      "assertions": [
        "an observation may be recorded without automatically becoming evidence",
        "an evidence reference carries attributable source identity",
        "evidence status does not imply truth without verification"
      ]
    },
    {
      "id": "K-VERIFY-01",
      "name": "verification may reject a result",
      "input": {
        "target_type": "artifact",
        "target_id": "artifact_001",
        "verification_status": "failed"
      },
      "assertions": [
        "verification status may be failed even when execution produced a result",
        "a failed verification cannot be upgraded to passed by repetition alone"
      ]
    },
    {
